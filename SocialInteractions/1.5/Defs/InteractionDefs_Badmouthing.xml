<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <InteractionDef>
    <defName>Badmouthing</defName>
    <label>badmouth someone</label>
    <workerClass>SocialInteractions.InteractionWorker_Badmouthing</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] spoke negatively about someone to [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] heard negative comments from [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>EnhancedInsult</defName>
    <label>enhanced insult</label>
    <workerClass>SocialInteractions.InteractionWorker_EnhancedInsult</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] insulted [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] was insulted by [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>Admiration</defName>
    <label>admiration</label>
    <workerClass>SocialInteractions.InteractionWorker_Admiration</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Speech</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] expressed admiration for [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] received admiration from [INITIATOR_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

  <InteractionDef>
    <defName>Backstabbing</defName>
    <label>strategic backstabbing</label>
    <workerClass>SocialInteractions.InteractionWorker_Backstabbing</workerClass>
    <symbol>Things/Mote/SpeechSymbols/Insult</symbol>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] attempted to manipulate [RECIPIENT_nameDef] about [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
    <logRulesRecipient>
      <rulesStrings>
        <li>r_logentry->[RECIPIENT_nameDef] was approached by [INITIATOR_nameDef] with information about [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesRecipient>
  </InteractionDef>

</Defs>