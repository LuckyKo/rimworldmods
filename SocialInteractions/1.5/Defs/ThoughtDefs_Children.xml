<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>ChildAnnoyance</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>3</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
        </nullifyingTraits>
        <stages>
            <li>
                <label>child annoyance</label>
                <description>A child was bothering me with annoying questions and behavior.</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildMisbehaved</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.0</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
        </nullifyingTraits>
        <stages>
            <li>
                <label>child misbehaved</label>
                <description>One of the children in the colony misbehaved terribly.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildBoredom</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.25</durationDays> <!-- 6 hours -->
        <stackLimit>3</stackLimit>
        <stages>
            <li>
                <label>bored child</label>
                <description>A child in the colony is feeling bored and restless.</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
            <li>
                <label>bored child</label>
                <description>A child in the colony is feeling very bored and restless.</description>
                <baseMoodEffect>-2</baseMoodEffect>
                <labelSocial>Child is Bored</labelSocial>
            </li>
            <li>
                <label>bored child</label>
                <description>A child in the colony is feeling extremely bored and restless.</description>
                <baseMoodEffect>-3</baseMoodEffect>
                <labelSocial>Child is Very Bored</labelSocial>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildCrying</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.03</durationDays> <!-- ~45 minutes -->
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
        </nullifyingTraits>
        <stages>
            <li>
                <label>crying</label>
                <description>I'm so sad and scared!</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildDestructive</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>destructive behavior</label>
                <description>I just destroyed something that probably shouldn't have been destroyed!</description>
                <baseMoodEffect>2</baseMoodEffect> <!-- Children might feel a bit good about being destructive -->
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildMischievous</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.25</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>mischievous</label>
                <description>I tried to do something mischievous but couldn't find anything to mess with.</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildRiskTaking</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>risk-taking</label>
                <description>I wanted to do something really dangerous but couldn't figure out how.</description>
                <baseMoodEffect>1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ChildReckless</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.0</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
        </nullifyingTraits>
        <stages>
            <li>
                <label>reckless behavior</label>
                <description>I did something really dangerous and reckless!</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>