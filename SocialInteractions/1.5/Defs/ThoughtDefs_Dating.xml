<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>ReconcilingAfterCheating</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>trying to reconcile</label>
        <description>I'm trying to work through this betrayal. It's hard, but I still care.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>BrokeUpAfterCheating</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>broke up after cheating</label>
        <description>I had to end it after what I saw. It was the right thing to do.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ThreewayLovin</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>threeway lovin'</label>
        <description>That was quite an experience! Not something I do every day.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Thoughts related to badmouthing interactions -->
  <ThoughtDef>
    <defName>HeardBadmouthing</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2.5</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>heard badmouthing</label>
        <description>Someone spoke negatively about me to another colonist.</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>WasToldNegativeThings</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2.5</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>was told negative things</label>
        <description>I was told negative things about someone else. It makes me think worse of them.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>