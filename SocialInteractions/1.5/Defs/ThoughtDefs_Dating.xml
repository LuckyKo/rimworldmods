<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>ReconcilingAfterCheating</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>trying to reconcile</label>
        <description>I'm trying to work through this betrayal. It's hard, but I still care.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>BrokeUpAfterCheating</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>broke up after cheating</label>
        <description>I had to end it after what I saw. It was the right thing to do.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ThreewayLovin</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>threeway lovin'</label>
        <description>That was quite an experience! Not something I do every day.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Thoughts related to badmouthing interactions -->
  <ThoughtDef>
    <defName>HeardBadmouthing</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2.5</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>heard badmouthing</label>
        <description>Someone spoke negatively about me to another colonist.</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>WasToldNegativeThings</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2.5</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>was told negative things</label>
        <description>I was told negative things about someone else. It makes me think worse of them.</description>
        <baseMoodEffect>-2</baseMoodEffect>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Thoughts related to gossip and shared opinions -->
  <ThoughtDef>
    <defName>BondedOverSharedDislike</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>bonded over shared dislike</label>
        <description>I've connected with someone over our shared negative feelings about another colonist. It's nice to know I'm not alone in my opinions.</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>FoundCommonGround</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>1.5</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>found common ground</label>
        <description>I connected with someone by discovering we have similar feelings about others in the colony.</description>
        <baseMoodEffect>3</baseMoodEffect>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <!-- Thoughts related to admiration interactions -->
  <ThoughtDef>
    <defName>SeekingApproval</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>seeking approval</label>
        <description>I've been looking to gain approval from someone I view as a leader or role model in our colony.</description>
        <baseMoodEffect>1</baseMoodEffect>
        <baseOpinionOffset>2</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>AdmiredBySomeone</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>admired by someone</label>
        <description>Someone has been showing admiration and respect for me, which feels good.</description>
        <baseMoodEffect>2</baseMoodEffect>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Thoughts related to strategic backstabbing -->
  <ThoughtDef>
    <defName>WasBackstabbed</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>was the victim of strategic backstabbing</label>
        <description>Someone I trusted used deception to turn others against me. The betrayal cuts deep, especially given how much trust I had placed in them.</description>
        <baseMoodEffect>-15</baseMoodEffect>
        <baseOpinionOffset>-20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>SuccessfullyBackstabbedSomeone</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>successfully manipulated someone</label>
        <description>I successfully used deception to turn someone against a mutual acquaintance. The manipulation was flawless.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>WasManipulatedAgainstSomeone</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>was manipulated against someone</label>
        <description>I was deceived into thinking negatively about someone I previously trusted. My opinion of them has been completely reversed due to this manipulation.</description>
        <baseMoodEffect>-10</baseMoodEffect>
        <baseOpinionOffset>-100</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>WasTargetOfFailedManipulation</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>was target of failed manipulation</label>
        <description>Someone attempted to manipulate me into thinking negatively about another colonist. I saw through their deception, but I'm still annoyed they tried to trick me.</description>
        <baseMoodEffect>-5</baseMoodEffect>
        <baseOpinionOffset>-50</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>FailedBackstabAttempt</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>failed backstab attempt</label>
        <description>My attempt to manipulate someone against another colonist was discovered. They saw right through my deception, which is embarrassing.</description>
        <baseMoodEffect>-8</baseMoodEffect>
        <baseOpinionOffset>-30</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Thoughts related to date outcomes -->
  <ThoughtDef>
    <defName>DateWentBadly</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>2.5</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>date went badly with {0}</label>
        <description>That date was awkward and uncomfortable. I don't think we're compatible.</description>
        <baseMoodEffect>-8</baseMoodEffect>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>EnjoyedDateWith</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>enjoyed date with {0}</label>
        <description>I really enjoyed spending time with someone special. That was wonderful.</description>
        <baseMoodEffect>5</baseMoodEffect>
        <baseOpinionOffset>5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>